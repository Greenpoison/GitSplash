{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitsplash",
  "version": "1.0.12-beta",
  "identifier": "com.gitsplash.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitsplash",
        "width": 1400,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "GitSplash"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNzBGRkJEOEE4NDVBQjMKUldTeldvU0t2Zjl3VzVtZXZZUXllcFJ0VjZVZG00ZGRNQUQzWnZCRG5MWGJ1OGwxMXRKZXN3SFoK",
      "endpoints": [
        "https://github.com/Greenpoison/GitSplash/releases/latest/download/latest.json"
      ]
    }
  }
}
