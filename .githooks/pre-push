#!/bin/sh
# Bumps the patch version on every push (see scripts/bump-version.js) and
# folds it into a small commit before the push goes out, so the version
# shown in the app always reflects what's actually live on main. Stays on
# 0.x.y — nothing here touches major/minor; that's a deliberate manual call.
set -e

cd "$(git rev-parse --show-toplevel)"

NEW_VERSION=$(node scripts/bump-version.cjs)

git add package.json package-lock.json src-tauri/tauri.conf.json src-tauri/Cargo.toml
git commit -m "chore: bump version to $NEW_VERSION"
